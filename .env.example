# Copy to `.env` for local development. Every variable is validated at startup
# by lib/env-schema.ts; add new variables there and here in the same change.
# Never commit real values.

# Canonical origin of the site, without a trailing slash.
# Optional: defaults to http://localhost:3000 locally. On Vercel it is derived
# from the deployment URL when unset.
SITE_URL=

# Postgres connection string. `docker compose up -d` starts a local database
# that matches this value. Use a separate database for every environment.
DATABASE_URL=postgres://template:template@127.0.0.1:5432/template

# Signs CMS auth tokens. At least 32 characters; generate one with
# `openssl rand -hex 32`. Use a different value in every environment.
PAYLOAD_SECRET=

# Vercel Blob read-write token for media uploads. Optional: without it files
# are stored on local disk in /media. Set it in every deployed environment,
# with a separate Blob store per environment.
BLOB_READ_WRITE_TOKEN=

# Shared secret of the CMS live preview. Optional: without it the preview
# button is hidden. At least 32 characters (`openssl rand -hex 32`).
PREVIEW_SECRET=

# Bearer token for scheduled jobs, which publish scheduled pages. Vercel Cron
# sends it automatically when the variable is set in the project. Optional
# locally. At least 16 characters.
CRON_SECRET=

# Search engines index only the Vercel production deployment. On another host,
# set this to `true` on the production instance only. Leave unset elsewhere.
ALLOW_INDEXING=

# E-mail through Resend. Optional: without the key and the sender, e-mails
# (invitations, password resets, contact form notifications) are written to
# the server log. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Address that receives contact form messages. Optional: without it messages
# are stored in the CMS only.
CONTACT_EMAIL_TO=

# The seed (`pnpm seed`) runs only when this is exactly `true`. Leave it unset
# in production: the seed overwrites the pages it owns and the site settings.
ALLOW_SEED=

# Build-time migrations (`pnpm vercel-build`). Production builds on Vercel
# migrate. Preview builds migrate only when this is `true`: set it once every
# preview has its own database, for example a Neon branch per preview.
PREVIEW_DATABASE_ISOLATED=

# Off Vercel: set to `true` to migrate during the build, or run
# `pnpm payload migrate` before starting. `false` switches build-time
# migrations off everywhere.
MIGRATE_ON_BUILD=
