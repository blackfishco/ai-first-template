# Copy to `.env` for local development. Every variable is validated at startup
# by lib/env-schema.ts; add new variables there and here in the same change.
# Never commit real values.

# Canonical origin of the site, without a trailing slash.
# Optional: defaults to http://localhost:3000 locally. On Vercel it is derived
# from the deployment URL when unset.
SITE_URL=

# Postgres connection string. `docker compose up -d` starts a local database
# that matches this value. Use a separate database for every environment.
DATABASE_URL=postgres://template:template@127.0.0.1:5432/template

# Signs CMS auth tokens. At least 32 characters; generate one with
# `openssl rand -hex 32`. Use a different value in every environment.
PAYLOAD_SECRET=
